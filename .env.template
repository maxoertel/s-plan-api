# s-plan | s-work
APP_MODE=

# Main application database (shared by every data source).
MAIN_DB_URL=
MAIN_DB_USER=
MAIN_DB_PASS=

AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=

APP_ENV=
OTLP_ENDPOINT=
OTLP_AUTH_BASE64=

LOKI_ENDPOINT=
LOKI_USERNAME=
LOKI_PASSWORD=

# Canonical IANA zone used to encode/decode the timezone-naive TIMESTAMP columns in the
# database. Must match the convention the database already uses. The API always exchanges
# absolute UTC epoch millis; this only controls how those instants are stored as wall-clock
# values in the DB. REQUIRED: the app fails to start if this is unset or invalid.
APP_DB_TIMEZONE=Europe/Berlin

# Whether the delivery note tables of this installation carry the super plasticizer column
# (entladungfliessmittel). Older legacy schemas do not have it: reads then fall back to a
# constant and writes are skipped. Set manually to match the schema. Defaults to false.
DELIVERY_NOTE_SUPER_PLASTICIZER_COLUMN_EXISTS=

# Whether the delivery note tables of this installation carry the mission accepted column
# (instrackangenommendatumzeit). Without it reads return no accepted time and writes are skipped.
# Set manually to match the schema. Defaults to false.
DELIVERY_NOTE_ACCEPTED_AT_COLUMN_EXISTS=

# Column the driver note of a mission is read from, as a.<column> (order) or ls.<column> (delivery
# note), e.g. ls.lieferscheinbemerkung. Defaults to a.auftragsinfo.
MISSION_DRIVER_NOTE_COLUMN=

# Whether the delivery note tables of this installation carry the waiting time column
# (entladungwartezeit). Without it reads return no waiting time and writes are skipped. Set manually
# to match the schema. Defaults to false.
DELIVERY_NOTE_WAITING_TIME_COLUMN_EXISTS=

